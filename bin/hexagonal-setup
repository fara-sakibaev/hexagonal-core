#!/usr/bin/env php
<?php

declare(strict_types=1);

$args = array_slice($argv, 1);
$apply = in_array('--apply', $args, true);
$dryRun = in_array('--dry-run', $args, true);
$choice = null;
$explicit = null;
$architecture = null;
foreach ($args as $index => $arg) {
    if ($arg === '--analyzer') $choice = $args[$index + 1] ?? null;
    if ($arg === '--architecture') $architecture = $args[$index + 1] ?? null;
    if ($arg === '--config') $explicit = $args[$index + 1] ?? null;
}
if ($choice !== null && !in_array($choice, ['phpstan', 'psalm'], true)) {
    fwrite(STDERR, "Choose --analyzer phpstan|psalm\n");
    exit(2);
}
$root = getcwd();
$packageRoot = dirname(__DIR__);
$architectureScope = null;
if ($architecture !== null) {
    $autoloadCandidates = [$packageRoot.'/vendor/autoload.php', $packageRoot.'/../../autoload.php', $root.'/vendor/autoload.php'];
    foreach ($autoloadCandidates as $autoload) {
        if (is_file($autoload)) { require_once $autoload; break; }
    }
    $architecture = str_starts_with($architecture, '/') ? $architecture : $root.'/'.$architecture;
    try {
        $architectureScope = \Hexagonal\StaticAnalysis\Architecture\ScopeConfiguration::fromFile($architecture);
    } catch (InvalidArgumentException $exception) {
        fwrite(STDERR, '[hexagonal.invalidScope] '.$exception->getMessage()."\n");
        exit(2);
    }
    fwrite(STDOUT, "Architecture scope: $architecture\n");
    foreach ($architectureScope->searchPaths as $directory) fwrite(STDOUT, "Search: $directory\n");
    foreach ($architectureScope->testPaths as $directory) fwrite(STDOUT, "Tests: $directory\n");
    foreach ((new \Hexagonal\StaticAnalysis\Architecture\ContextDiscovery())->candidates($architectureScope) as $directory) {
        $status = in_array($directory, $architectureScope->contextRoots, true) ? 'declared' : 'undeclared';
        fwrite(STDOUT, "Context candidate ($status): $directory\n");
    }
}
$composer = is_file($root.'/composer.json') ? json_decode(file_get_contents($root.'/composer.json'), true) : [];
$scripts = implode(' ', array_map(static fn ($value) => is_array($value) ? implode(' ', $value) : (string) $value, $composer['scripts'] ?? []));
$candidates = [];
foreach (['phpstan.neon', 'phpstan.neon.dist', 'phpstan.dist.neon', 'psalm.xml', 'psalm.xml.dist'] as $name) {
    if (is_file($root.'/'.$name)) $candidates[$name] = str_starts_with($name, 'psalm') ? 'psalm' : 'phpstan';
}
if (preg_match_all('/(?:^|\s)(?:-c|--configuration)(?:=|\s+)([^\s"\x27]+)/', $scripts, $matches)) {
    foreach ($matches[1] as $path) {
        if (is_file($root.'/'.$path)) $candidates[$path] = str_contains($path, 'psalm') || str_ends_with($path, '.xml') ? 'psalm' : 'phpstan';
    }
}
if ($explicit !== null) {
    $candidates = is_file($root.'/'.$explicit) ? [$explicit => $choice ?? (str_ends_with($explicit, '.xml') ? 'psalm' : 'phpstan')] : [];
    if ($candidates === []) { fwrite(STDERR, "Config not found: $explicit\n"); exit(2); }
}
if ($choice !== null) $candidates = array_filter($candidates, static fn ($analyzer) => $analyzer === $choice);
if (count($candidates) > 1) {
    fwrite(STDERR, "Ambiguous configs: ".implode(', ', array_keys($candidates)).". Use --config PATH.\n");
    exit(2);
}
if ($candidates === []) {
    if ($choice === null) {
        fwrite(STDOUT, "No active config found. Choose --analyzer phpstan or --analyzer psalm.\n");
        exit(2);
    }
    $path = $choice === 'phpstan' ? 'phpstan.neon' : 'psalm.xml';
    $before = '';
} else {
    $path = array_key_first($candidates);
    $choice = $candidates[$path];
    $before = file_get_contents($root.'/'.$path);
}
if ($choice === 'phpstan') {
    $include = $packageRoot.'/phpstan-extension.neon';
    if ($before === '') {
        $after = "includes:\n    - $include\n\nparameters:\n    level: 8\n    paths:\n        - src\n";
    } elseif (str_contains($before, $include)) {
        $after = $before;
    } elseif (preg_match('/^includes\s*:\s*$/m', $before)) {
        $after = preg_replace('/^includes\s*:\s*$/m', "includes:\n    - $include", $before, 1);
    } else {
        $after = rtrim($before)."\n\nincludes:\n    - $include\n";
    }
} else {
    $plugin = 'Hexagonal\\StaticAnalysis\\Psalm\\HandlerPlugin';
    $after = $before === '' ? '<?xml version="1.0"?><psalm errorLevel="7"><projectFiles><directory name="src"/></projectFiles><plugins><pluginClass class="'.$plugin.'"/></plugins></psalm>' : $before;
    if ($before !== '' && !str_contains($before, $plugin)) {
        $dom = new DOMDocument();
        if (!$dom->loadXML($before)) { fwrite(STDERR, "Invalid Psalm XML: $path\n"); exit(2); }
        $rootNode = $dom->documentElement;
        $namespace = $rootNode->namespaceURI;
        $plugins = $rootNode->getElementsByTagName('plugins')->item(0);
        if ($plugins === null) { $plugins = $dom->createElementNS($namespace, 'plugins'); $rootNode->appendChild($plugins); }
        $node = $dom->createElementNS($namespace, 'pluginClass');
        $node->setAttribute('class', $plugin);
        $plugins->appendChild($node);
        $dom->formatOutput = true;
        $after = $dom->saveXML();
    }
}
if ($architectureScope !== null) {
    if ($choice === 'phpstan') {
        $setting = '    hexagonalArchitecture: '.json_encode($architecture, JSON_UNESCAPED_SLASHES)."\n";
        if (preg_match('/^    hexagonalArchitecture:.*$/m', $after)) {
            $after = preg_replace_callback('/^    hexagonalArchitecture:.*\n?/m', static fn () => $setting, $after, 1);
        } elseif (preg_match('/^parameters:\s*$/m', $after)) {
            $after = preg_replace_callback('/^parameters:\s*$/m', static fn () => "parameters:\n".rtrim($setting), $after, 1);
        } elseif (preg_match('/^parameters:\s*\{\s*\}\s*$/m', $after)) {
            $after = preg_replace_callback('/^parameters:\s*\{\s*\}\s*$/m', static fn () => "parameters:\n".rtrim($setting), $after, 1);
        } elseif (!preg_match('/^parameters:/m', $after)) {
            $after = rtrim($after)."\n\nparameters:\n".$setting;
        } else {
            fwrite(STDERR, "Cannot safely edit parameters; add hexagonalArchitecture to the existing configuration manually.\n");
            exit(2);
        }
        if ($before === '') {
            $paths = array_unique([...$architectureScope->searchPaths, ...$architectureScope->testPaths]);
            $after = str_replace("        - src\n", implode('', array_map(static fn ($directory) => '        - '.json_encode($directory, JSON_UNESCAPED_SLASHES)."\n", $paths)), $after);
        }
    } else {
        $dom = new DOMDocument();
        $dom->loadXML($after);
        $namespace = $dom->documentElement->namespaceURI;
        foreach ($dom->getElementsByTagName('pluginClass') as $node) {
            if ($node->getAttribute('class') !== $plugin) continue;
            $setting = $node->getElementsByTagName('architecture')->item(0);
            if ($setting === null) { $setting = $dom->createElementNS($namespace, 'architecture'); $node->appendChild($setting); }
            $setting->setAttribute('path', $architecture);
        }
        if ($before === '') {
            $files = $dom->getElementsByTagName('projectFiles')->item(0);
            while ($files->firstChild) $files->removeChild($files->firstChild);
            foreach (array_unique([...$architectureScope->searchPaths, ...$architectureScope->testPaths]) as $directory) {
                $node = $dom->createElementNS($namespace, 'directory');
                $node->setAttribute('name', $directory);
                $files->appendChild($node);
            }
        }
        $dom->formatOutput = true;
        $after = $dom->saveXML();
    }
}
fwrite(STDOUT, "Analyzer: $choice; config: $path\n");
if ($after === $before) { fwrite(STDOUT, "Already configured; no changes.\n"); exit(0); }
fwrite(STDOUT, "Proposed diff:\n");
foreach (explode("\n", rtrim($before)) as $line) if ($before !== '') fwrite(STDOUT, "- $line\n");
foreach (explode("\n", rtrim($after)) as $line) fwrite(STDOUT, "+ $line\n");
if (!$apply || $dryRun) { fwrite(STDOUT, "Preview only. Use --apply to write.\n"); exit(0); }
file_put_contents($root.'/'.$path, $after);
fwrite(STDOUT, "Updated $path. Add vendor/bin/$choice to a root Composer script and CI.\n");
