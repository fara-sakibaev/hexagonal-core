{
  "name": "fara-sakibaev/hexagonal-symfony-validator",
  "description": "Symfony Validator bridge for hexagonal-core",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": "^8.5",
    "fara-sakibaev/hexagonal-core": "^0.1 || dev-main",
    "symfony/validator": "^7.4 || ^8.1"
  },
  "autoload": {
    "psr-4": {"Hexagonal\\SymfonyValidator\\": "src/"}
  },
  "scripts": {"test": "php -d zend.assertions=1 -d assert.exception=1 tests/integration.php"},
  "repositories": [
    {"type": "path", "url": "../..", "options": {"symlink": true}}
  ],
  "minimum-stability": "dev",
  "prefer-stable": true
}
