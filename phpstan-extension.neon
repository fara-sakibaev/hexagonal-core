parameters:
    errorFormat: hexagonal
    hexagonalArchitecture: null

parametersSchema:
    hexagonalArchitecture: schema(string(), nullable())

services:
    -
        class: Hexagonal\StaticAnalysis\PHPStan\ArchitectureCollector
        tags: [phpstan.collector]
    -
        class: Hexagonal\StaticAnalysis\PHPStan\ArchitectureRule
        arguments:
            configuration: %hexagonalArchitecture%
        tags: [phpstan.rules.rule]
    -
        class: Hexagonal\StaticAnalysis\PHPStan\HandlerRule
        tags: [phpstan.rules.rule]
    -
        class: Hexagonal\StaticAnalysis\PHPStan\ReadPortCollector
        tags: [phpstan.collector]
    errorFormatter.hexagonal:
        class: Hexagonal\StaticAnalysis\PHPStan\WarningErrorFormatter
        arguments:
            delegate: @errorFormatter.table
    errorFormatter.hexagonalJson:
        class: Hexagonal\StaticAnalysis\PHPStan\WarningJsonErrorFormatter
