{
  "name": "fara-sakibaev/hexagonal-core",
  "description": "Contracts for hexagonal architecture",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": "^8.5",
    "symfony/uid": "^7.4 || ^8.1",
    "ext-simplexml": "*"
  },
  "autoload": {
    "psr-4": {
      "Hexagonal\\": "src/"
    }
  },
  "bin": [
    "bin/hexagonal-setup"
  ],
  "scripts": {
    "cs:check": "php-cs-fixer fix --dry-run --diff --sequential",
    "cs:fix": "php-cs-fixer fix --sequential",
    "analyse:phpstan": "phpstan analyse --debug --no-progress --level 8 --autoload-file vendor/autoload.php -c phpstan-extension.neon src tests/fixtures/valid-contracts.php tests/fixtures/validation-example.php",
    "analyse:psalm": "psalm --no-cache --threads=1 -c psalm.xml",
    "test:outbox": "php -d zend.assertions=1 -d assert.exception=1 tests/outbox.php",
    "test:setup": "php -d zend.assertions=1 -d assert.exception=1 tests/setup.php",
    "test:validation": "php -d zend.assertions=1 -d assert.exception=1 tests/validation.php",
    "test:analysis": "php -d zend.assertions=1 -d assert.exception=1 tests/static-analysis.php"
  },
  "require-dev": {
    "phpstan/phpstan": "^2",
    "vimeo/psalm": "^6",
    "friendsofphp/php-cs-fixer": "^3.95"
  }
}
